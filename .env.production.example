# Copy to .env on the server. Never commit .env.
ADMIN_PASSWORD=change-me
# SendGrid key for contact, registration and newsletter emails (same account as the booking site).
SENDGRID_API_KEY=
EMAIL_FROM_ADDRESS=noreply@momentumnetball.co.uk
EMAIL_FROM_NAME=Momentum Netball
ADMIN_EMAIL=hello@momentumnetball.co.uk
# Build-time (also read by docker compose as build args)
NEXT_PUBLIC_BOOKING_URL=https://booking.momentumnetball.co.uk
NEXT_PUBLIC_MST_URL=https://momentumsportstechnology.com
NEXT_PUBLIC_SITE_URL=https://momentumnetball.co.uk

#!/usr/bin/env bash
set -e
eval "$(portmap momentum-marketing)"
PROJECT=momentum-mkt
start() {
    [ -d node_modules ] || yarn install
    tmux new-session -d -s "$PROJECT-fe" -c "$PWD" \
        "yarn dev --port $FRONTEND_PORT --hostname 127.0.0.1; echo '[fe exited]'; tail -f /dev/null" 2>/dev/null || true
    echo "momentum-marketing: fe=$FRONTEND_PORT"
}
stop() { tmux kill-session -t "$PROJECT-fe" 2>/dev/null || true; }
case "$1" in
    start) start ;; stop) stop ;; restart) stop; start ;;
    status) tmux ls 2>/dev/null | grep "^$PROJECT-" || echo "(no sessions)" ;;
    *) echo "usage: $0 {start|stop|restart|status}" >&2; exit 1 ;;
esac
